#
# ESP32-C5: WiFi buffer pools sized for the internal RAM this chip has.
#
# The C5 is single-core with ~166 KiB of internal RAM for dynamic allocation,
# shared with code. IDF's defaults let the radio's receive pools alone claim up
# to 70 KB of it; with the setup portal up and nothing draining the stack that
# exhausted internal RAM and reboot-looped the BLE gateway on this chip (espOS
# issue #124). This firmware has no Bluetooth stack, so it has more headroom,
# but the portal case is the same, and a candump stream at full bus load is
# about 80 KB/s, which these pools carry easily. No PSRAM: it is not needed
# without Bluetooth, and leaving it off keeps the image right for C5 modules
# that have none.
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=12
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=12
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=16
CONFIG_ESP_WIFI_RX_BA_WIN=6
